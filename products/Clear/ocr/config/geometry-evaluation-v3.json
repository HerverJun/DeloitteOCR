{
  "protocol_version": 3,
  "created": "2026-09-15",
  "production_default": false,
  "primary_boundary_convention": "full_grid",
  "grid_recipe": "pubtables-midpoint-grid-v1",
  "distinct_boundary_conventions": ["text_extent", "pdf_cell_extent", "full_grid"],
  "historical_boundary_convention": "pdf_cell_extent",
  "historical_reports_immutable": true,
  "iou_threshold": 0.5,
  "minimum_precise_coverage": 0.9,
  "maximum_wrong_cell_rate": 0.01,
  "minimum_offered_quality": 0.95,
  "minimum_tables": 120,
  "minimum_targets": 6000,
  "minimum_independent_documents": 100,
  "correspondence_p95_ms": 200,
  "test_requires_preinference_seal": true,
  "exclude_all_previously_prepared_documents": true,
  "exclude_previously_exposed_test_sets": ["table-matching-v2", "tableformer-expanded-20260914"],
  "required_label_reviews": ["merged", "empty", "wide_gutter", "ruled", "official_structure_xml"],
  "required_real_input_categories": ["native_pdf", "physical_scan", "chinese", "full_page_multiple_tables"],
  "rasterized_pdf_is_physical_scan": false,
  "unlabelled_public_pdfs_are_quality_evidence": false,
  "adoption_rule": "successful PaddleOCR-VL result only; no reference edits and no per-sample engine selection",
  "comparators": ["TableFormer-local-v2", "TableFormer-local-v3", "Paddle-local-v2", "RapidTable-local-v2"],
  "subgroups": ["merged", "repeated", "empty"],
  "failures_remain_in_denominator": true
}
