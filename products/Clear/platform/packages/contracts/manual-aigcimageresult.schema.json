{
  "additionalProperties": false,
  "description": "Whole-image signal; a score is not a calibrated generation probability.",
  "properties": {
    "calibration": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Calibration"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "preprocessing_version": {
      "minLength": 1,
      "title": "Preprocessing Version",
      "type": "string"
    },
    "qualification": {
      "const": "experimental",
      "title": "Qualification",
      "type": "string"
    },
    "raw_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Score"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "score_direction": {
      "const": "higher_is_generated",
      "title": "Score Direction",
      "type": "string"
    },
    "state": {
      "enum": [
        "signal_detected",
        "no_significant_signal",
        "unable_to_assess"
      ],
      "title": "State",
      "type": "string"
    },
    "threshold": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Threshold"
    }
  },
  "required": [
    "schema_version",
    "state",
    "raw_score",
    "score_direction",
    "threshold",
    "calibration",
    "qualification",
    "scope",
    "limitations",
    "preprocessing_version"
  ],
  "title": "AigcImageResult",
  "type": "object"
}
