{
  "$defs": {
    "LocalActor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "const": "local",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "source"
      ],
      "title": "LocalActor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/LocalActor"
    },
    "assessment": {
      "enum": [
        "needs_investigation",
        "inconclusive",
        "no_supported_clue"
      ],
      "title": "Assessment",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "note": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "request_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "expected_revision",
    "actor",
    "assessment",
    "note"
  ],
  "title": "InspectionReview",
  "type": "object"
}
