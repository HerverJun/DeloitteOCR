{
  "additionalProperties": false,
  "properties": {
    "device": {
      "default": "cpu",
      "enum": [
        "cpu",
        "cuda"
      ],
      "title": "Device",
      "type": "string"
    },
    "expected_scope_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Scope Revision"
    },
    "link_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Link Id"
    },
    "model_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "model_name": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
      "title": "Request Id",
      "type": "string"
    },
    "use_existing_model": {
      "default": false,
      "title": "Use Existing Model",
      "type": "boolean"
    }
  },
  "required": [
    "request_id"
  ],
  "title": "PredictRequest",
  "type": "object"
}
