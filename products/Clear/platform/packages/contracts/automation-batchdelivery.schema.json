{
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Id"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "intermediate",
            "final"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kind"
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "status": {
      "default": "none",
      "enum": [
        "none",
        "current",
        "outdated"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "title": "BatchDelivery",
  "type": "object"
}
