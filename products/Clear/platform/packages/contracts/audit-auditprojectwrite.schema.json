{
  "$defs": {
    "AuditProjectFields": {
      "additionalProperties": false,
      "properties": {
        "audit_object": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Audit Object",
          "type": "string"
        },
        "objective": {
          "maxLength": 4000,
          "title": "Objective",
          "type": "string"
        },
        "period_end": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Period Start",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "audit_object",
        "period_start",
        "period_end",
        "objective"
      ],
      "title": "AuditProjectFields",
      "type": "object"
    },
    "LocalActor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "const": "local",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "source"
      ],
      "title": "LocalActor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/LocalActor"
    },
    "audit_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Audit Version",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/AuditProjectFields"
    },
    "request_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "actor",
    "expected_revision",
    "project"
  ],
  "title": "AuditProjectWrite",
  "type": "object"
}
