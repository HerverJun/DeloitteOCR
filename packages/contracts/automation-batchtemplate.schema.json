{
  "additionalProperties": false,
  "properties": {
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "scenario": {
      "enum": [
        "data_compare",
        "classification",
        "ocr"
      ],
      "title": "Scenario",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "template_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Template Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "workspace_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "template_id",
    "version",
    "name",
    "scenario",
    "config",
    "config_hash",
    "created_at"
  ],
  "title": "BatchTemplate",
  "type": "object"
}
