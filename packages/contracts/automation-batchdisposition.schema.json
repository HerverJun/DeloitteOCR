{
  "$defs": {
    "LocalActor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "const": "local",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "source"
      ],
      "title": "LocalActor",
      "type": "object"
    },
    "NativeAdoption": {
      "additionalProperties": false,
      "properties": {
        "human_label_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Label Id"
        },
        "native_result_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Result Id"
        },
        "native_revision": {
          "minimum": 0,
          "title": "Native Revision",
          "type": "integer"
        },
        "native_version_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Version Id"
        }
      },
      "required": [
        "native_revision"
      ],
      "title": "NativeAdoption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "confirm",
        "defer",
        "reopen",
        "adopt"
      ],
      "title": "Action",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/LocalActor"
    },
    "adoption": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeAdoption"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "automation_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Automation Version",
      "type": "string"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "item_ids": {
      "items": {
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Item Ids",
      "type": "array"
    },
    "note": {
      "default": "",
      "maxLength": 2000,
      "title": "Note",
      "type": "string"
    },
    "request_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "expected_revision",
    "actor",
    "item_ids",
    "action"
  ],
  "title": "BatchDisposition",
  "type": "object"
}
