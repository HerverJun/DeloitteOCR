{
  "$defs": {
    "AuditDirectEvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "snapshot_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "source_evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
          "title": "Source Evidence Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "source_evidence_id",
        "snapshot_hash"
      ],
      "title": "AuditDirectEvidenceSelection",
      "type": "object"
    },
    "AuditEvidenceKeep": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id"
      ],
      "title": "AuditEvidenceKeep",
      "type": "object"
    },
    "AuditEvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Batch Id",
          "type": "string"
        },
        "batch_revision": {
          "minimum": 1,
          "title": "Batch Revision",
          "type": "integer"
        },
        "item_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Item Id",
          "type": "string"
        }
      },
      "required": [
        "batch_id",
        "item_id",
        "batch_revision"
      ],
      "title": "AuditEvidenceSelection",
      "type": "object"
    },
    "AuditFindingFields": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "default": "",
          "maxLength": 4000,
          "title": "Conclusion",
          "type": "string"
        },
        "explanation": {
          "default": "",
          "maxLength": 4000,
          "title": "Explanation",
          "type": "string"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "high",
            "normal",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "AuditFindingFields",
      "type": "object"
    },
    "ForensicEvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "inspection_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Inspection Id",
          "type": "string"
        },
        "inspection_revision": {
          "minimum": 1,
          "title": "Inspection Revision",
          "type": "integer"
        },
        "report_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Report Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "inspection_id",
        "inspection_revision",
        "report_hash"
      ],
      "title": "ForensicEvidenceSelection",
      "type": "object"
    },
    "LocalActor": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "const": "local",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name",
        "source"
      ],
      "title": "LocalActor",
      "type": "object"
    },
    "ManualEvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "manual_bundle_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Manual Bundle Id",
          "type": "string"
        }
      },
      "required": [
        "manual_bundle_id"
      ],
      "title": "ManualEvidenceSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/LocalActor"
    },
    "audit_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Audit Version",
      "type": "string"
    },
    "evidence": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/AuditEvidenceSelection"
          },
          {
            "$ref": "#/$defs/ForensicEvidenceSelection"
          },
          {
            "$ref": "#/$defs/AuditEvidenceKeep"
          },
          {
            "$ref": "#/$defs/AuditDirectEvidenceSelection"
          },
          {
            "$ref": "#/$defs/ManualEvidenceSelection"
          }
        ]
      },
      "maxItems": 100,
      "title": "Evidence",
      "type": "array"
    },
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "finding": {
      "$ref": "#/$defs/AuditFindingFields"
    },
    "request_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "actor",
    "expected_revision",
    "finding",
    "evidence"
  ],
  "title": "AuditFindingWrite",
  "type": "object"
}
