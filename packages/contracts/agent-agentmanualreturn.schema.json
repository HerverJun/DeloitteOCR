{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "properties": {
        "application": {
          "default": "platform",
          "enum": [
            "platform",
            "data",
            "ocr",
            "classification",
            "forensics"
          ],
          "title": "Application",
          "type": "string"
        },
        "coverage": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Coverage",
          "type": "object"
        },
        "kind": {
          "enum": [
            "asset",
            "asset_set",
            "table",
            "result",
            "artifact",
            "job",
            "evidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "native_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Id"
        },
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
          "title": "Object Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Revision"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/AgentRef"
          },
          "maxItems": 100,
          "title": "Sources",
          "type": "array"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "workspace_id",
        "object_id",
        "revision"
      ],
      "title": "AgentRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "include_asset_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Include Asset Ids",
      "type": "array"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/AgentRef"
      },
      "maxItems": 50,
      "title": "References",
      "type": "array"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,80}$",
      "title": "Request Id",
      "type": "string"
    },
    "summary": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "expected_revision",
    "summary"
  ],
  "title": "AgentManualReturn",
  "type": "object"
}
